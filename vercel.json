{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npx --yes pnpm@10.32.1 install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "proxy": {
    "entrypoint": "search-indexing-proxy.ts",
    "matcher": ["/"]
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.+)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/assets/(.*-[A-Za-z0-9_-]{8}\\.(?:js|css|woff2))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/",
      "missing": [{ "type": "query", "key": "site-editor-preview" }, { "type": "query", "key": "motionBenchmark" }],
      "headers": [{ "key": "Link", "value": "</fonts/CormorantGaramond-Variable.woff2>; rel=preload; as=font; type=\"font/woff2\"; crossorigin=anonymous" }]
    },
    {
      "source": "/(spirit/?)",
      "missing": [{ "type": "query", "key": "site-editor-preview" }, { "type": "query", "key": "motionBenchmark" }],
      "headers": [{ "key": "Link", "value": "</fonts/Fraunces-Black-Latin.woff2>; rel=preload; as=font; type=\"font/woff2\"; crossorigin=anonymous, </fonts/BarlowCondensed-SemiBold-Latin.woff2>; rel=preload; as=font; type=\"font/woff2\"; crossorigin=anonymous, <https://fonts.googleapis.com>; rel=preconnect, <https://fonts.gstatic.com>; rel=preconnect; crossorigin=anonymous" }]
    },
    {
      "source": "/((?:about|concerts|notices|gallery|join|contact|(?:concerts|notices)/[^/]+)/?)",
      "missing": [{ "type": "query", "key": "site-editor-preview" }, { "type": "query", "key": "motionBenchmark" }],
      "headers": [{ "key": "Link", "value": "</fonts/Hahmlet-Variable.woff2>; rel=preload; as=font; type=\"font/woff2\"; crossorigin=anonymous" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": ".+\\.vercel\\.app" }],
      "destination": "https://seoulmotetyouthchoir.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|fonts/|fonts$).*)",
      "destination": "/index.html"
    }
  ]
}
