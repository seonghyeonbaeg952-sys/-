<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fffdf9" />
    <title>서울모테트청소년합창단 — 기록 섹션 모션 샘플</title>
    <link rel="stylesheet" href="./archive-exposure-current.css" />
  </head>
  <body>
    <section
      class="archive-exposure"
      id="archiveExposure"
      data-stage="ready"
      data-year="2026"
      aria-label="기록 섹션 모션그래픽"
      aria-busy="false"
    >
      <div aria-hidden="true" class="archive-exposure__grain"></div>
      <div aria-hidden="true" class="archive-exposure__orb archive-exposure__orb--a"></div>
      <div aria-hidden="true" class="archive-exposure__orb archive-exposure__orb--b"></div>

      <div aria-hidden="true" class="archive-exposure__topline">
        <span>Archive study · exposure sequence</span>
        <small>Light / Time / Memory</small>
      </div>

      <div class="archive-exposure__layout">
        <div class="archive-exposure__copy" id="archiveCopy">
          <p class="archive-exposure__eyebrow" id="archiveEyebrow">00 · Ready</p>
          <div id="archiveHeadingSlot">
            <h1 class="archive-exposure__heading">
              <span>무대의 순간을</span>
              <span>한 장씩 다시 펼칩니다</span>
            </h1>
          </div>
          <p class="archive-exposure__body" id="archiveBody">
            공연 사진과 포스터, 영상으로 남은 기록을 빛과 시간의 순서로 천천히 만나보세요.
          </p>
          <div id="archiveDetailSlot">
            <p class="archive-exposure__status">2026 · 공연 기록</p>
          </div>
          <div class="archive-exposure__actions">
            <button class="archive-exposure__primary" id="archiveStart" type="button">
              <span>기록 펼치기</span><span aria-hidden="true">→</span>
            </button>
            <a class="archive-exposure__secondary" id="archiveGallery" href="/gallery" hidden>
              <span>갤러리 보기</span><span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="archive-exposure__visual" id="archiveVisual">
          <div class="archive-exposure__apparatus" id="archiveApparatus">
            <div aria-hidden="true" class="archive-exposure__surface"></div>
            <div aria-hidden="true" class="archive-exposure__film-bed" id="archiveFilmBed"></div>
            <div aria-hidden="true" class="archive-exposure__develop-glow" id="archiveDevelopGlow"></div>
            <div aria-hidden="true" class="archive-exposure__archive-field" id="archiveField"></div>

            <div aria-hidden="true" class="archive-exposure__crop-marks" id="archiveCropMarks">
              <i></i><i></i><i></i><i></i>
            </div>

            <div aria-hidden="true" class="archive-exposure__film-ghosts" id="archiveFilmGhosts">
              <span class="archive-exposure__film-ghost">
                <img src="./images/sample/about-collective-portrait.png" alt="" /><small>01</small>
              </span>
              <span class="archive-exposure__film-ghost">
                <img src="./images/sample/about-collective-portrait.png" alt="" /><small>02</small>
              </span>
              <span class="archive-exposure__film-ghost">
                <img src="./images/sample/about-collective-portrait.png" alt="" /><small>04</small>
              </span>
              <span class="archive-exposure__film-ghost">
                <img src="./images/sample/about-collective-portrait.png" alt="" /><small>05</small>
              </span>
            </div>

            <figure class="archive-exposure__carrier" id="archiveCarrier">
              <div class="archive-exposure__carrier-media" id="archiveCarrierMedia">
                <img
                  src="./images/sample/about-collective-portrait.png"
                  alt="서울모테트청소년합창단 겨울 수련회 단체 사진"
                />
                <span aria-hidden="true" class="archive-exposure__carrier-grain"></span>
                <span aria-hidden="true" class="archive-exposure__latent-veil" id="archiveVeil"></span>
                <span aria-hidden="true" class="archive-exposure__reveal-edge" id="archiveRevealEdge"></span>
                <span aria-hidden="true" class="archive-exposure__scan-line" id="archiveScanLine"></span>
              </div>
              <figcaption>
                <span id="archiveCarrierIndex">01 / 사진</span>
                <small id="archiveCarrierCaption">함께 배우고 노래한 겨울 수련회</small>
              </figcaption>
            </figure>

            <a class="archive-exposure__record archive-exposure__record--poster" id="archivePoster" href="/gallery#poster" tabindex="-1">
              <span class="archive-exposure__record-media">
                <img src="./images/placeholders/poster-placeholder.svg" alt="서울모테트청소년합창단 공연 포스터" />
              </span>
              <span class="archive-exposure__record-label"><b>02</b><span>/ 포스터</span></span>
            </a>

            <a class="archive-exposure__record archive-exposure__record--video" id="archiveVideo" href="/gallery#video" tabindex="-1">
              <span class="archive-exposure__record-media">
                <img src="./images/sample/about-collective-portrait.png" alt="서울모테트청소년합창단 공연 영상 썸네일" />
                <span aria-hidden="true" class="archive-exposure__play">▶</span>
              </span>
              <span class="archive-exposure__record-label"><b>03</b><span>/ 영상</span></span>
            </a>

            <span aria-hidden="true" class="archive-exposure__measure" id="archiveMeasure">Sequence complete · 03 records</span>
            <div aria-hidden="true" class="archive-exposure__flash" id="archiveFlash"></div>
          </div>
        </div>
      </div>

      <div aria-hidden="true" class="archive-exposure__footer">
        <span id="archiveFooterLabel">00 READY</span>
        <div class="archive-exposure__progress" id="archiveProgress">
          <i class="is-active"></i><i></i><i></i><i></i><i></i>
        </div>
        <small id="archiveFooterCopy">기록을 고르고 빛을 준비합니다</small>
      </div>

      <p aria-live="polite" class="sr-only" id="archiveLive"></p>
    </section>

    <script type="module">
      import {
        createTimeline,
        cubicBezier,
        engine,
        stagger,
      } from "./vendor/anime.esm.min.js";

      engine.pauseOnDocumentHidden = true;

      const section = document.querySelector("#archiveExposure");
      const copy = document.querySelector("#archiveCopy");
      const visual = document.querySelector("#archiveVisual");
      const apparatus = document.querySelector("#archiveApparatus");
      const carrier = document.querySelector("#archiveCarrier");
      const carrierMedia = document.querySelector("#archiveCarrierMedia");
      const carrierIndex = document.querySelector("#archiveCarrierIndex");
      const carrierCaption = document.querySelector("#archiveCarrierCaption");
      const startButton = document.querySelector("#archiveStart");
      const galleryButton = document.querySelector("#archiveGallery");
      const cropMarks = document.querySelector("#archiveCropMarks");
      const cropCorners = [...cropMarks.querySelectorAll("i")];
      const scanLine = document.querySelector("#archiveScanLine");
      const flash = document.querySelector("#archiveFlash");
      const filmBed = document.querySelector("#archiveFilmBed");
      const filmGhosts = [...document.querySelectorAll(".archive-exposure__film-ghost")];
      const developGlow = document.querySelector("#archiveDevelopGlow");
      const veil = document.querySelector("#archiveVeil");
      const revealEdge = document.querySelector("#archiveRevealEdge");
      const archiveField = document.querySelector("#archiveField");
      const poster = document.querySelector("#archivePoster");
      const video = document.querySelector("#archiveVideo");
      const measure = document.querySelector("#archiveMeasure");
      const live = document.querySelector("#archiveLive");
      const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");

      const EASE_ENTER = cubicBezier(0.23, 1, 0.32, 1);
      const EASE_MOVE = cubicBezier(0.77, 0, 0.175, 1);
      const EASE_EXIT = cubicBezier(0.4, 0, 1, 1);

      const TRANSFORM = {
        ready: "translate3d(-50%, -50%, 0) rotateZ(-1.2deg) scale(0.94)",
        capture: "translate3d(-50%, -50%, 0) rotateZ(0deg) scale(0.985)",
        negative: "translate3d(-50%, -50%, 0) rotateZ(0deg) scale(0.225)",
        develop: "translate3d(-50%, -50%, 0) rotateZ(0.55deg) scale(0.965)",
        archive: "translate3d(-73%, -65%, 0) rotateZ(-1.15deg) scale(0.7)",
      };

      const stages = [
        {
          id: "ready",
          number: "00",
          english: "Ready",
          heading: ["무대의 순간을", "한 장씩", "다시 펼칩니다"],
          body: "공연 사진과 포스터, 영상으로 남은 기록을 빛과 시간의 순서로 천천히 만나보세요.",
          detail: "공연 기록",
          progress: "기록을 고르고 빛을 준비합니다",
          carrier: "원본 기록",
        },
        {
          id: "capture",
          number: "01",
          english: "Capture",
          heading: ["무대의 빛과", "목소리를 한 장에", "담습니다"],
          body: "원본의 비율은 그대로 두고, 기록에 남길 빛의 범위와 중심을 살핍니다.",
          detail: "빛의 범위를 확인합니다",
          progress: "사진의 비율을 바꾸지 않고 빛을 읽습니다",
          carrier: "노출 확인",
        },
        {
          id: "negative",
          number: "02",
          english: "Contact",
          heading: ["한 장의 순간을", "시간의 순서로", "잇습니다"],
          body: "연속된 프레임 속에서 같은 무대의 흐름과 표정을 차분하게 되짚습니다.",
          detail: "연속 기록을 확인합니다",
          progress: "가운데 원본을 기준으로 앞뒤 시간을 연결합니다",
          carrier: "선택 프레임 03",
        },
        {
          id: "develop",
          number: "03",
          english: "Develop",
          heading: ["희미했던 장면이", "종이 위로", "떠오릅니다"],
          body: "따뜻한 빛이 지나가며 사진 속 표정과 공간의 명암을 다시 선명하게 만듭니다.",
          detail: "기록이 선명해지는 중",
          progress: "빛이 지나간 자리부터 장면이 드러납니다",
          carrier: "인화 중",
        },
        {
          id: "archive",
          number: "04",
          english: "Archive",
          heading: ["완성된 기록을", "오늘 다시 펼칩니다"],
          body: "사진·포스터·영상으로 남은 한 해의 기록을 원본 비율 그대로 한 화면에서 확인합니다.",
          detail: "모든 기록을 펼쳤습니다",
          progress: "사진·포스터·영상 기록이 모두 준비되었습니다",
          carrier: "보관 완료",
        },
      ];

      const year = section.dataset.year || "2026";
      let motionTimeline = null;
      let running = false;
      let pointerFrame = 0;

      function setInline(element, styles) {
        Object.assign(element.style, styles);
      }

      function renderStage(index, announce = true) {
        const stage = stages[index];
        section.dataset.stage = stage.id;
        document.querySelector("#archiveEyebrow").textContent = `${stage.number} · ${stage.english}`;

        const headingSlot = document.querySelector("#archiveHeadingSlot");
        const detailSlot = document.querySelector("#archiveDetailSlot");
        if (stage.id === "archive") {
          headingSlot.innerHTML = `
            <strong class="archive-exposure__year">${year}</strong>
            <h1 class="archive-exposure__heading archive-exposure__heading--final">함께 배우고 노래한 겨울 수련회</h1>`;
          detailSlot.innerHTML = `
            <dl class="archive-exposure__meta">
              <div><dt>Collection</dt><dd>Seoul Motet Youth Choir</dd></div>
              <div><dt>Medium</dt><dd>Photo · Poster · Video</dd></div>
              <div><dt>Archive no.</dt><dd>SMY—${year}</dd></div>
            </dl>`;
        } else {
          headingSlot.innerHTML = `<h1 class="archive-exposure__heading">${stage.heading
            .map((line) => `<span>${line}</span>`)
            .join("")}</h1>`;
          detailSlot.innerHTML = `<p class="archive-exposure__status">${stage.id === "ready" ? `${year} · ${stage.detail}` : `${stage.number} / 04 · ${stage.detail}`}</p>`;
        }

        document.querySelector("#archiveBody").textContent = stage.body;
        document.querySelector("#archiveFooterLabel").textContent = `${stage.number} ${stage.english.toUpperCase()}`;
        document.querySelector("#archiveFooterCopy").textContent = stage.progress;
        document.querySelectorAll("#archiveProgress i").forEach((item, itemIndex) => {
          item.classList.toggle("is-active", itemIndex <= index);
        });

        carrierIndex.textContent = stage.id === "negative" ? "03 / 선택 프레임" : "01 / 사진";
        carrierCaption.textContent = stage.id === "archive" ? "함께 배우고 노래한 겨울 수련회" : stage.carrier;
        galleryButton.hidden = stage.id !== "archive";
        poster.tabIndex = stage.id === "archive" ? 0 : -1;
        video.tabIndex = stage.id === "archive" ? 0 : -1;
        startButton.querySelector("span").textContent = running
          ? "기록을 펼치는 중…"
          : stage.id === "archive"
            ? "다시 펼치기"
            : "기록 펼치기";

        if (announce) live.textContent = stage.progress;
      }

      function resetVisualState() {
        setInline(copy, { opacity: "1", transform: "translate3d(0, 0, 0)" });
        setInline(carrier, { opacity: "1", transform: TRANSFORM.ready });
        setInline(cropMarks, { opacity: "0" });
        cropCorners.forEach((corner) => setInline(corner, { transform: "scale(0.72)" }));
        setInline(scanLine, { opacity: "0", transform: "translate3d(0, 0, 0)" });
        setInline(flash, { opacity: "0" });
        setInline(filmBed, { opacity: "0" });
        filmGhosts.forEach((ghost) => setInline(ghost, {
          opacity: "0",
          transform: "translate3d(-50%, calc(-50% + 12px), 0) scale(0.94)",
        }));
        setInline(developGlow, { opacity: "0" });
        setInline(veil, { opacity: "0", transform: "scaleX(1)" });
        setInline(revealEdge, { opacity: "0", transform: "translate3d(0, 0, 0)" });
        setInline(archiveField, { opacity: "0" });
        setInline(poster, {
          opacity: "0",
          transform: "translate3d(24px, 18px, 0) rotateZ(3deg) rotateY(-7deg) scale(0.96)",
        });
        setInline(video, {
          opacity: "0",
          transform: "translate3d(28px, 24px, 0) rotateZ(4deg) rotateY(-8deg) scale(0.96)",
        });
        setInline(measure, { opacity: "0" });
      }

      function applyArchiveState() {
        resetVisualState();
        renderStage(4, false);
        setInline(carrier, { opacity: "1", transform: TRANSFORM.archive });
        setInline(archiveField, { opacity: "1" });
        setInline(poster, {
          opacity: "1",
          transform: "translate3d(0, 0, 0) rotateZ(1.3deg) rotateY(0deg) scale(1)",
        });
        setInline(video, {
          opacity: "1",
          transform: "translate3d(0, 0, 0) rotateZ(-1.1deg) rotateY(0deg) scale(1)",
        });
        setInline(measure, { opacity: "1" });
      }

      function queueCopyStage(timeline, index, at) {
        timeline
          .add(copy, {
            opacity: 0,
            transform: "translate3d(0, -8px, 0)",
            duration: 150,
            ease: EASE_EXIT,
          }, at - 150)
          .call(() => renderStage(index), at)
          .set(copy, { transform: "translate3d(0, 11px, 0)" }, at)
          .add(copy, {
            opacity: 1,
            transform: "translate3d(0, 0, 0)",
            duration: 420,
            ease: EASE_ENTER,
          }, at + 10);
      }

      function createArchiveTimeline() {
        const scanTravel = Math.max(280, carrierMedia.getBoundingClientRect().height - 18);
        const revealTravel = Math.max(320, carrierMedia.getBoundingClientRect().width - 4);
        const timeline = createTimeline({
          autoplay: false,
          onComplete: () => {
            running = false;
            section.classList.remove("is-running");
            section.setAttribute("aria-busy", "false");
            startButton.disabled = false;
            renderStage(4, false);
            live.textContent = "사진·포스터·영상 기록을 모두 펼쳤습니다.";
          },
        });

        queueCopyStage(timeline, 1, 240);
        timeline
          .add(carrier, { transform: TRANSFORM.capture, duration: 650, ease: EASE_MOVE }, 80)
          .add(cropMarks, { opacity: 1, duration: 240, ease: EASE_ENTER }, 210)
          .add(cropCorners, {
            transform: "scale(1)", duration: 360, delay: stagger(42), ease: EASE_ENTER,
          }, 220)
          .add(scanLine, {
            opacity: [0, 1], transform: `translate3d(0, ${scanTravel}px, 0)`, duration: 1080, ease: EASE_MOVE,
          }, 560)
          .add(scanLine, { opacity: 0, duration: 130, ease: EASE_EXIT }, 1540)
          .add(flash, { opacity: [0, 0.74, 0], duration: 150, ease: "linear" }, 1560);

        queueCopyStage(timeline, 2, 1900);
        timeline
          .add(cropMarks, { opacity: 0, duration: 180, ease: EASE_EXIT }, 1740)
          .add(filmBed, { opacity: 1, duration: 520, ease: EASE_ENTER }, 1760)
          .add(carrier, { transform: TRANSFORM.negative, duration: 780, ease: EASE_MOVE }, 1780)
          .add(filmGhosts, {
            opacity: 1,
            transform: "translate3d(-50%, -50%, 0) scale(1)",
            duration: 430,
            delay: stagger(58, { from: "center" }),
            ease: EASE_ENTER,
          }, 2140)
          .add(filmGhosts, {
            opacity: [1, 0.72], duration: 680, delay: stagger(36, { from: "center" }), ease: EASE_MOVE,
          }, 2790);

        queueCopyStage(timeline, 3, 3680);
        timeline
          .add(filmGhosts, {
            opacity: 0,
            transform: "translate3d(-50%, calc(-50% - 8px), 0) scale(0.96)",
            duration: 260,
            delay: stagger(34, { from: "center" }),
            ease: EASE_EXIT,
          }, 3480)
          .add(filmBed, { opacity: 0, duration: 520, ease: EASE_EXIT }, 3560)
          .add(developGlow, { opacity: 1, duration: 680, ease: EASE_ENTER }, 3600)
          .add(carrier, { transform: TRANSFORM.develop, duration: 920, ease: EASE_MOVE }, 3520)
          .set(veil, { opacity: 1, transform: "scaleX(1)" }, 4160)
          .set(revealEdge, { opacity: 0, transform: "translate3d(0, 0, 0)" }, 4160)
          .add(veil, { transform: "scaleX(0)", duration: 1620, ease: EASE_MOVE }, 4220)
          .add(revealEdge, {
            opacity: [0, 1], transform: `translate3d(${revealTravel}px, 0, 0)`, duration: 1510, ease: EASE_MOVE,
          }, 4250)
          .add(revealEdge, { opacity: 0, duration: 130, ease: EASE_EXIT }, 5720);

        queueCopyStage(timeline, 4, 6200);
        timeline
          .add(developGlow, { opacity: 0, duration: 420, ease: EASE_EXIT }, 5940)
          .add(archiveField, { opacity: 1, duration: 620, ease: EASE_ENTER }, 5960)
          .add(carrier, { transform: TRANSFORM.archive, duration: 880, ease: EASE_MOVE }, 5940)
          .add(poster, {
            opacity: 1,
            transform: "translate3d(0, 0, 0) rotateZ(1.3deg) rotateY(0deg) scale(1)",
            duration: 650,
            ease: EASE_ENTER,
          }, 6420)
          .add(video, {
            opacity: 1,
            transform: "translate3d(0, 0, 0) rotateZ(-1.1deg) rotateY(0deg) scale(1)",
            duration: 650,
            ease: EASE_ENTER,
          }, 6510)
          .add(measure, { opacity: 1, duration: 340, ease: EASE_ENTER }, 6870);

        return timeline;
      }

      function stopMotion() {
        if (motionTimeline) {
          motionTimeline.revert();
          motionTimeline = null;
        }
        running = false;
        section.classList.remove("is-running");
        section.setAttribute("aria-busy", "false");
        startButton.disabled = false;
      }

      function startSequence() {
        if (running) return;
        stopMotion();

        if (reducedMotionQuery.matches) {
          applyArchiveState();
          live.textContent = "움직임을 줄여 완성된 기록을 표시했습니다.";
          return;
        }

        resetVisualState();
        renderStage(0, false);
        running = true;
        section.classList.add("is-running");
        section.setAttribute("aria-busy", "true");
        startButton.disabled = true;
        startButton.querySelector("span").textContent = "기록을 펼치는 중…";
        live.textContent = "기록 펼치기를 시작합니다.";
        motionTimeline = createArchiveTimeline();
        motionTimeline.play();
      }

      function handlePointerMove(event) {
        if (running || reducedMotionQuery.matches || !window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
        cancelAnimationFrame(pointerFrame);
        pointerFrame = requestAnimationFrame(() => {
          const bounds = visual.getBoundingClientRect();
          const x = ((event.clientX - bounds.left) / bounds.width - 0.5) * 7;
          const y = ((event.clientY - bounds.top) / bounds.height - 0.5) * 5;
          apparatus.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0) rotateX(${(-y * 0.16).toFixed(2)}deg) rotateY(${(x * 0.14).toFixed(2)}deg)`;
        });
      }

      function resetPointer() {
        cancelAnimationFrame(pointerFrame);
        apparatus.style.transform = "translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg)";
      }

      startButton.addEventListener("click", startSequence);
      visual.addEventListener("pointermove", handlePointerMove, { passive: true });
      visual.addEventListener("pointerleave", resetPointer, { passive: true });
      window.addEventListener("beforeunload", stopMotion);

      const params = new URLSearchParams(window.location.search);
      if (params.get("stage") === "archive") {
        applyArchiveState();
      } else {
        resetVisualState();
        renderStage(0, false);
        if (params.get("autoplay") === "1") window.setTimeout(startSequence, 450);
      }
    </script>
  </body>
</html>
